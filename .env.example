# Public URL of the deployed site (used for Open Graph / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://mwt-transport.example.com

# CARTO basemaps key for the map (free at https://carto.com/basemaps/apikey).
# It ships to the browser, so restrict it to your domain in the CARTO dashboard.
NEXT_PUBLIC_CARTO_KEY=

# --- Application delivery (all optional; configure at least one) ---

# Telegram bot: create a bot with @BotFather, add it to your chat, get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
APPLY_EMAIL_TO=recruiting@example.com
APPLY_EMAIL_FROM=MWT Applications <apply@yourdomain.com>

# Generic webhook (Google Apps Script web app for Google Sheets, Zapier, Make, etc.)
APPLY_WEBHOOK_URL=
